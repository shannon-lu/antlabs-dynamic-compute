# Copy to .env and edit. Everything is optional.

# Which backend talks to Claude.
#   sdk  (default) Claude Agent SDK. Uses your Claude Code login (Pro/Max subscription).
#                  If ANTHROPIC_API_KEY is set, the SDK uses the key instead of the login.
#   api            Direct Messages API with the per-message effort beta. Requires ANTHROPIC_API_KEY.
#COLLABORATE_PROVIDER=sdk

# Only needed for the api provider, or to make the sdk provider bill an API key instead of your subscription.
#ANTHROPIC_API_KEY=sk-ant-...

# Default model shown in the UI. Any of: claude-opus-5-5, claude-sonnet-5-5, claude-fable-5-1
#COLLABORATE_MODEL=claude-opus-5-5

# Port for the local web app.
#PORT=4310

# Pause length in milliseconds after the plan and before uncertain steps.
#COLLABORATE_PAUSE_MS=10000
